  ],
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "test": "node --test",
    "test:integration": "MP3_ATLAS_TESTS=1 node --test --test-concurrency=1 test/atlas.test.js test/http-atlas.test.js test/put-atlas.test.js test/delete-atlas.test.js test/contract-atlas.test.js",
    "test:atlas": "npm run test:integration",
    "configure:atlas": "node scripts/set-atlas-password.js",
    "submit": "node submit.js"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/cs409-fa25/mp3.git"
  },
