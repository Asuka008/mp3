# Copy to .env.test and supply an Atlas database URI privately.
# This may select a separate authorized test database, or use tracked UUID fixtures in mp3.
# TEST_MONGODB_URI is required; integration tests never fall back to .env.
TEST_MONGODB_URI="mongodb+srv://<encoded-database-user>:<encoded-database-password>@<atlas-cluster-host>/<test-database>?retryWrites=true&w=majority&authSource=admin"
